---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { href: '/', label: 'Beranda', disabled: false },
  { href: '/transparansi', label: 'Transparansi Dana', disabled: false },
  { href: '/lapor', label: 'Lapor', disabled: true },
  { href: '/edukasi', label: 'Edukasi & Panduan', disabled: true },
];
---

<header class="w-full bg-white rounded-[20px] border border-[#E6ECF5] shadow-[0_4px_20px_rgba(0,0,0,0.06)] px-5 sm:px-6 py-3.5">
  <div class="flex items-center justify-between">
    <!-- Brand Logo with Pemprov Jateng Image -->
    <a href="/" class="flex items-center gap-3 group shrink-0">
      <img
        src="/img/logo-pemprov-jateng.png"
        alt="Logo Pemerintah Provinsi Jawa Tengah"
        class="h-6 w-auto object-contain shrink-0"
        width="23"
        height="24"
      />
      <span class="font-bold text-[#0D2453] text-lg sm:text-xl tracking-tight group-hover:text-blue-900 transition-colors">
        DEWI JATENG
      </span>
    </a>

    <!-- Center Navigation Links with Active Underline -->
    <nav class="hidden md:flex items-center gap-7 lg:gap-8">
      {navItems.map((item) => {
        if (item.disabled) {
          return (
            <span
              class="text-sm text-[#0D2453]/40 font-semibold cursor-not-allowed select-none py-1"
              title="Fitur sedang disiapkan"
            >
              {item.label}
            </span>
          );
        }

        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`text-sm transition-all py-1 ${
              isActive
                ? 'text-[#0D2453] font-bold border-b-2 border-[#0D2453]'
                : 'text-[#0D2453]/70 font-semibold hover:text-[#0D2453]'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Right Actions: + Buat Laporan & Masuk -->
    <div class="flex items-center gap-2.5">
      <a
        href="/#buat-laporan"
        class="inline-flex items-center gap-1.5 px-4 sm:px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold bg-[#0D2453] text-white hover:bg-[#132d66] transition-all shadow-xs active:scale-95"
      >
        <span class="text-sm font-light leading-none">+</span>
        <span>Buat Laporan</span>
      </a>

      <button
        type="button"
        disabled
        title="Fitur masuk sedang disiapkan"
        class="inline-flex items-center px-4 sm:px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold bg-white text-[#0D2453]/40 border border-[#0D2453]/30 cursor-not-allowed select-none"
      >
        Masuk
      </button>
    </div>
  </div>
</header>
