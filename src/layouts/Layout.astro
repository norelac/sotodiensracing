---
import Navbar from '../components/astro/Navbar.astro';
import Footer from '../components/astro/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'DEWI JATENG - Dari Laporan, Menjadi Perbaikan',
  description = 'Pantau penggunaan dana desa secara terbuka dan laporkan kendala fasilitas wisata secara cepat.',
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Google Fonts: Plus Jakarta Sans, Inter, & Playfair Display (italic for cursive subtitle) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@1,500;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#F7F9FC] text-[#0D2453] font-sans antialiased min-h-screen flex flex-col selection:bg-blue-100 selection:text-[#0D2453]">
    <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 pt-4">
      <Navbar currentPath={currentPath} />
    </div>

    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
  </body>
</html>
