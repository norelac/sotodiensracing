---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Lapor - DEWI JATENG"
  description="Kanal Pengawasan Publik Bergaransi SLA - DEWI JATENG"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-20 text-center">
    <div class="max-w-md mx-auto p-8 rounded-3xl bg-white border border-[#EBEBEB] shadow-xs">
      <h1 class="text-xl font-bold text-[#0D2453]">Fitur Sedang Disiapkan</h1>
      <p class="text-xs sm:text-sm text-[#767676] mt-2">
        Halaman pelaporan sedang dalam tahap pengembangan dan sinkronisasi sistem. Anda dapat menggunakan formulir pelaporan di halaman Beranda.
      </p>
      <div class="mt-6">
        <a
          href="/#buat-laporan"
          class="inline-flex items-center px-5 py-2.5 rounded-full text-xs font-bold bg-[#0D2453] text-white hover:bg-[#132d66] transition-all shadow-xs"
        >
          Ke Formulir Beranda
        </a>
      </div>
    </div>
  </div>
</Layout>
