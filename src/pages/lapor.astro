---
import Layout from '../layouts/Layout.astro';
import ReportFormMotion from '../components/react/ReportFormMotion';
import {
  ShieldAlert,
  Clock,
  Lock,
  CheckCircle2,
  AlertTriangle,
  HelpCircle,
  FileCheck2
} from 'lucide-react';
---

<Layout
  title="Kanal Lapor Temuan Publik Bergaransi SLA - DEWI JATENG"
  description="Laporkan pungutan liar, ketidaksesuaian karcis, atau kerusakan fisik fasilitas wisata di Jawa Tengah. Dilindungi anonimitas penuh dan garansi tindak lanjut SLA 24 Jam/7 Hari."
>
  <div class="bg-gradient-to-b from-blue-950 via-slate-900 to-slate-900 text-white py-14 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-950/80 border border-red-700/60 text-red-300 text-xs font-semibold mb-4">
        <ShieldAlert class="w-3.5 h-3.5 text-red-400" />
        <span>Kanal Pengawasan Publik Bergaransi SLA</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight">
        Laporkan Pungli & Bahaya Fasilitas Wisata
      </h1>
      <p class="text-slate-300 text-sm sm:text-base leading-relaxed mt-3 max-w-2xl mx-auto">
        Kawal keselamatan pengunjung dan integritas tarif desa wisata. Setiap aduan dijamin anonim, dilacak dengan kode unik, dan wajib diselesaikan dengan bukti fisik sebelum ditutup.
      </p>

      {/* SLA Quick Grid */}
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-8 text-left">
        <div class="p-3.5 rounded-xl bg-slate-800/80 border border-slate-700/70">
          <div class="flex items-center gap-2 text-red-400 font-bold text-xs">
            <Clock class="w-4 h-4" />
            <span>SLA 24 JAM</span>
          </div>
          <div class="text-xs text-slate-300 mt-1 font-semibold">Pungutan Liar & Karcis Ilegal</div>
          <div class="text-[11px] text-slate-400 mt-0.5">Penertiban langsung satgas desa</div>
        </div>

        <div class="p-3.5 rounded-xl bg-slate-800/80 border border-slate-700/70">
          <div class="flex items-center gap-2 text-amber-400 font-bold text-xs">
            <AlertTriangle class="w-4 h-4" />
            <span>SLA 7 HARI (168 JAM)</span>
          </div>
          <div class="text-xs text-slate-300 mt-1 font-semibold">Bahaya Fasilitas Fisik & K3</div>
          <div class="text-[11px] text-slate-400 mt-0.5">Mandat penutupan wahana darurat</div>
        </div>

        <div class="p-3.5 rounded-xl bg-slate-800/80 border border-slate-700/70">
          <div class="flex items-center gap-2 text-emerald-400 font-bold text-xs">
            <Lock class="w-4 h-4" />
            <span>100% ANONIM</span>
          </div>
          <div class="text-xs text-slate-300 mt-1 font-semibold">Whistleblower Dilindungi</div>
          <div class="text-[11px] text-slate-400 mt-0.5">Enkripsi identitas pelapor</div>
        </div>
      </div>
    </div>
  </div>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Interactive Report Form Motion Island -->
    <ReportFormMotion client:load />

    <!-- Alur Penanganan Tiket -->
    <section class="max-w-3xl mx-auto mt-16 pt-12 border-t border-slate-200">
      <h3 class="text-xl font-bold text-slate-900 text-center mb-8">
        Bagaimana Aduan Anda Diproses Hingga Tuntas?
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 text-center">
        <div class="space-y-2">
          <div class="w-10 h-10 rounded-full bg-blue-100 text-blue-900 font-bold flex items-center justify-center mx-auto text-sm">
            1
          </div>
          <h4 class="text-xs font-bold text-slate-800">Tiket Terbit</h4>
          <p class="text-[11px] text-slate-500">
            Aduan diverifikasi koordinat GPS dan otomatis diberi batas hitung mundur SLA.
          </p>
        </div>

        <div class="space-y-2">
          <div class="w-10 h-10 rounded-full bg-blue-100 text-blue-900 font-bold flex items-center justify-center mx-auto text-sm">
            2
          </div>
          <h4 class="text-xs font-bold text-slate-800">Notifikasi Pengelola</h4>
          <p class="text-[11px] text-slate-500">
            Pokdarwis dan BPD desa wisata menerima disposisi penugasan teknis lapangan.
          </p>
        </div>

        <div class="space-y-2">
          <div class="w-10 h-10 rounded-full bg-blue-100 text-blue-900 font-bold flex items-center justify-center mx-auto text-sm">
            3
          </div>
          <h4 class="text-xs font-bold text-slate-800">Perbaikan Fisik</h4>
          <p class="text-[11px] text-slate-500">
            Tindakan perbaikan dilakukan dan didokumentasikan dalam format foto After.
          </p>
        </div>

        <div class="space-y-2">
          <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-800 font-bold flex items-center justify-center mx-auto text-sm">
            4
          </div>
          <h4 class="text-xs font-bold text-slate-800">Proof-of-Fix Rilis</h4>
          <p class="text-[11px] text-slate-500">
            Tiket ditutup publik dan hasil foto perbaikan tayang di halaman utama secara transparan.
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>
