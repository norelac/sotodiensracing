---
import Layout from '../../layouts/Layout.astro';
import PengelolaTicketBoard from '../../components/react/PengelolaTicketBoard';
import {
  ShieldAlert,
  Clock,
  CheckCircle2,
  AlertTriangle,
  Upload,
  PlusCircle,
  FileText,
  UserCheck,
  Building,
  KeyRound
} from 'lucide-react';
---

<Layout
  title="Portal Pengelola & Disposisi Tiket - DEWI JATENG"
  description="Dashboard operasional pengurus Pokdarwis dan BUMDes desa wisata Jawa Tengah untuk menindaklanjuti tiket aduan masyarakat dan menerbitkan bukti perbaikan Proof-of-Fix."
>
  <div class="bg-gradient-to-b from-slate-900 via-blue-950 to-slate-900 text-white py-12 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-950/80 border border-emerald-700/60 text-emerald-300 text-xs font-semibold mb-3">
            <KeyRound class="w-3.5 h-3.5" />
            <span>Mode Demo Juri WIA 2026: Terautentikasi Pokdarwis Binaan</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
            Portal Penugasan Lapangan & Resolusi Tiket SLA
          </h1>
          <p class="text-slate-300 text-xs sm:text-sm mt-2 max-w-2xl">
            Area kerja terpadu untuk merespons aduan wisatawan, mengunggah bukti nyata perbaikan (Proof-of-Fix), serta menjaga skor kepatuhan integritas desa wisata Anda.
          </p>
        </div>

        <!-- Quick Info Tag -->
        <div class="p-4 rounded-2xl bg-slate-800/80 border border-slate-700 text-right shrink-0">
          <div class="text-xs text-slate-400">Desa Binaan Login:</div>
          <div class="text-base font-bold text-white mt-0.5">Desa Wisata Limpakuwus</div>
          <div class="text-xs text-emerald-400 font-mono mt-0.5">Kab. Banyumas • Terverifikasi BPD</div>
        </div>
      </div>
    </div>
  </div>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">
    <!-- Action Guidance Box -->
    <div class="p-5 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <AlertTriangle class="w-5 h-5 text-amber-700 shrink-0" />
        <div class="text-xs leading-relaxed">
          <strong>Mandat Integritas Resolusi:</strong> Tiket dalam status <em>In Progress</em> wajib disertai unggahan foto kondisi fisik sesudah perbaikan (Foto After) dan deskripsi teknis sebelum sistem menandainya sebagai <em>Resolved</em>.
        </div>
      </div>
    </div>

    <!-- Ticket Management Interactive Island -->
    <section>
      <PengelolaTicketBoard client:load />
    </section>

    <!-- Form Cepat Input Buku Kas Desa -->
    <section class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-6 border-b border-slate-100">
        <div>
          <div class="text-xs font-bold uppercase tracking-wider text-blue-900 mb-1">
            Transparansi Keuangan Terbuka
          </div>
          <h3 class="text-xl font-bold text-slate-900">
            Pencatatan Cepat Mutasi Kas & Faktur Nota Belanja
          </h3>
          <p class="text-xs text-slate-500 mt-1">
            Unggah nota belanja riil untuk otomatis dipindai oleh AI OCR dan dicocokkan dengan katalog Standar Satuan Harga (SSH) Pemprov Jateng.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div>
          <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Kategori Pengeluaran</label>
          <select class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs font-medium text-slate-800">
            <option>KESELAMATAN_K3</option>
            <option>MATERIAL</option>
            <option>UPAH_KERJA</option>
            <option>OPERASIONAL</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Nominal Transaksi (Rp)</label>
          <input
            type="text"
            placeholder="Contoh: 15.000.000"
            class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs text-slate-800"
          />
        </div>

        <div>
          <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Nama Toko / Rekanan</label>
          <input
            type="text"
            placeholder="Contoh: TB Makmur Sentosa"
            class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs text-slate-800"
          />
        </div>

        <div class="flex items-end">
          <button
            type="button"
            class="w-full py-2.5 px-4 rounded-xl bg-blue-900 hover:bg-blue-800 text-white font-bold text-xs flex items-center justify-center gap-1.5 transition-colors"
          >
            <Upload class="w-4 h-4" />
            <span>Unggah Nota & Simpan Kas</span>
          </button>
        </div>
      </div>
    </section>
  </main>
</Layout>
