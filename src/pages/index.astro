---
import Layout from '../layouts/Layout.astro';
import {
  FileText,
  ChevronRight
} from 'lucide-react';
import HomeKpiCounters from '../components/react/HomeKpiCounters';
import HomeReportForm from '../components/react/HomeReportForm';
import HomeReportFeed from '../components/react/HomeReportFeed';
---

<Layout
  title="DEWI JATENG - Dari Laporan, Menjadi Perbaikan"
  description="Pantau penggunaan dana desa secara terbuka dan laporkan kendala fasilitas wisata secara cepat."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 space-y-8 mt-4">

    <!-- 1. Hero Section Banner Card with Terrace Mountain Background -->
    <section class="relative rounded-3xl overflow-hidden shadow-sm border border-[#EBEBEB]">
      <!-- Landscape Background Image with Dark Vignette Overlay -->
      <div class="absolute inset-0 z-0">
        <img
          src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=1600&auto=format&fit=crop&q=80"
          alt="Desa Wisata Jawa Tengah - Lanskap Pegunungan & Sawah Berundak"
          class="w-full h-full object-cover object-center filter brightness-[0.75] contrast-[1.05]"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-slate-950/80 via-slate-900/50 to-transparent"></div>
      </div>

      <div class="relative z-10 px-6 sm:px-12 lg:px-14 py-14 sm:py-20 max-w-3xl text-white">
        <!-- Script / Cursive Subtitle -->
        <p class="font-serif italic text-white/95 text-xl sm:text-2xl mb-2 tracking-wide drop-shadow-sm">
          Desa Wisata Jawa Tengah
        </p>

        <!-- Main Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.12] text-white drop-shadow-sm">
          Dari Laporan,<br />Menjadi Perbaikan
        </h1>

        <!-- Sub-headline -->
        <p class="text-white/90 text-sm sm:text-base mt-4 max-w-xl leading-relaxed drop-shadow-sm font-normal">
          Pantau penggunaan dana desa secara terbuka dan laporkan kendala fasilitas wisata secara cepat
        </p>

        <!-- Dual CTA Buttons -->
        <div class="flex flex-wrap items-center gap-3.5 mt-8">
          <a
            href="#buat-laporan"
            class="px-6 py-3 rounded-full bg-white text-[#0D2453] hover:bg-slate-100 font-bold text-xs sm:text-sm shadow-md transition-all active:scale-95"
          >
            Buat Laporan
          </a>
          <a
            href="/transparansi"
            class="px-6 py-3 rounded-full bg-white/20 hover:bg-white/30 backdrop-blur-md text-white border border-white/40 font-bold text-xs sm:text-sm shadow-sm transition-all active:scale-95"
          >
            Lihat Transparansi Dana Desa
          </a>
        </div>
      </div>
    </section>

    <!-- 2. Four Metric KPI Cards (Animated Island) -->
    <section>
      <HomeKpiCounters client:visible />
    </section>

    <!-- 3. Section Buat Laporan Card (Interactive Form & Jateng Map Island) -->
    <section id="buat-laporan" class="bg-white rounded-3xl border border-[#EBEBEB] p-6 sm:p-10 shadow-xs">
      <!-- Card Header -->
      <div class="mb-6">
        <div class="flex items-center gap-2 text-[#0D2453]">
          <FileText class="w-5 h-5 text-[#0D2453]" />
          <h2 class="text-xl font-bold tracking-tight text-[#0D2453]">
            Buat Laporan
          </h2>
        </div>
        <p class="text-xs sm:text-sm text-[#767676] mt-1">
          Sampaikan pengaduan Anda secara mudah dan cepat.
        </p>
      </div>

      <HomeReportForm client:load />
    </section>

    <!-- 4. Section Dari Laporan, Menjadi Perbaikan -->
    <section class="space-y-6 pt-4">
      <div>
        <h2 class="text-2xl font-bold text-[#0D2453] tracking-tight">
          Dari Laporan, Menjadi Perbaikan
        </h2>
        <p class="text-xs sm:text-sm text-[#767676] mt-0.5">
          Ikuti kabar penggunaan dana dan fasilitas desa.
        </p>
      </div>

      <!-- Interactive Report Feed Component -->
      <HomeReportFeed client:visible />

      <!-- Lihat Lainnya CTA Button -->
      <div class="flex justify-end pt-2 pb-8">
        <a
          href="/lapor"
          class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full bg-white border border-[#EBEBEB] text-[#0D2453] hover:bg-slate-50 text-xs font-bold shadow-xs transition-colors"
        >
          <span>Lihat Lainnya</span>
          <ChevronRight class="w-4 h-4 text-slate-400" />
        </a>
      </div>
    </section>

  </div>
</Layout>
