---
import Layout from '../layouts/Layout.astro';
import {
  Landmark,
  ChevronDown,
  ArrowUpRight,
  ChevronLeft,
  ChevronRight,
  FileText,
  X
} from 'lucide-react';

// Empirical data matching the Figma layout for Desa Candirejo, Magelang
const expenditures = [
  {
    id: 'exp-1',
    date: '16 Okt 2026',
    title: 'Perbaikan jalur pejalan kaki',
    sub: 'Akses wisata & pagar pengaman',
    amount: '320.000.000',
    receiptImg: 'https://images.unsplash.com/photo-1554415707-9e4966a6e483?w=800&auto=format&fit=crop&q=80',
    photoImg: 'https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&auto=format&fit=crop&q=80',
  },
  {
    id: 'exp-2',
    date: '12 Okt 2026',
    title: 'Penataan area parkir wisata',
    sub: 'Permukaan & marka area parkir',
    amount: '240.000.000',
    receiptImg: 'https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=800&auto=format&fit=crop&q=80',
    photoImg: 'https://images.unsplash.com/photo-1590674899484-d5640e854abe?w=800&auto=format&fit=crop&q=80',
  },
  {
    id: 'exp-3',
    date: '08 Okt 2026',
    title: 'Pengelolaan kebersihan desa',
    sub: 'Tempat sampah & sarana kebersihan',
    amount: '180.000.000',
    receiptImg: 'https://images.unsplash.com/photo-1554415707-9e4966a6e483?w=800&auto=format&fit=crop&q=80',
    photoImg: 'https://images.unsplash.com/photo-1532996122724-e3c354a0b15b?w=800&auto=format&fit=crop&q=80',
  },
  {
    id: 'exp-4',
    date: '05 Okt 2026',
    title: 'Pemeliharaan toilet wisata',
    sub: 'Sanitasi & perbaikan fasilitas',
    amount: '100.000.000',
    receiptImg: 'https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=800&auto=format&fit=crop&q=80',
    photoImg: 'https://images.unsplash.com/photo-1584622781564-1d987f7333c1?w=800&auto=format&fit=crop&q=80',
  },
];
---

<Layout
  title="Transparansi Dana Desa - DEWI JATENG"
  description="Dari mana dana berasal dan untuk apa dibelanjakan? Telusuri anggaran hingga bukti penggunaannya."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 space-y-6 mt-4">

    <!-- 1. Header Title & Subtitle -->
    <div>
      <div class="flex items-center gap-2.5 text-[#0D2453]">
        <Landmark class="w-6 h-6 text-[#0D2453]" />
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[#0D2453]">
          Transparansi Dana Desa
        </h1>
      </div>
      <p class="text-xs sm:text-sm text-[#767676] mt-1">
        Dari mana dana berasal dan untuk apa dibelanjakan? Telusuri anggaran hingga bukti penggunaannya.
      </p>
    </div>

    <!-- 2. Filter Bar Card -->
    <section class="bg-white rounded-2xl border border-[#EBEBEB] p-5 sm:p-6 shadow-xs">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-4 items-end">
        <!-- Pilih Kabupaten -->
        <div class="lg:col-span-4">
          <label class="block text-xs font-bold text-[#0D2453] mb-1.5">
            Pilih Kabupaten
          </label>
          <div class="relative">
            <select
              class="w-full bg-[#F5F5F5] border-0 rounded-xl px-4 py-3 text-xs sm:text-sm text-[#0D2453] font-medium focus:ring-2 focus:ring-[#0D2453]/20 focus:outline-none appearance-none cursor-pointer"
            >
              <option selected>Kabupaten Magelang</option>
              <option>Kabupaten Banyumas</option>
              <option>Kabupaten Kendal</option>
              <option>Kabupaten Karanganyar</option>
              <option>Kabupaten Banjarnegara</option>
              <option>Kabupaten Wonosobo</option>
            </select>
            <ChevronDown class="w-4 h-4 text-slate-400 absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none" />
          </div>
        </div>

        <!-- Pilih Desa -->
        <div class="lg:col-span-4">
          <label class="block text-xs font-bold text-[#0D2453] mb-1.5">
            Pilih Desa
          </label>
          <div class="relative">
            <select
              class="w-full bg-[#F5F5F5] border-0 rounded-xl px-4 py-3 text-xs sm:text-sm text-[#0D2453] font-medium focus:ring-2 focus:ring-[#0D2453]/20 focus:outline-none appearance-none cursor-pointer"
            >
              <option selected>Desa Candirejo</option>
              <option>Desa Limpakuwus</option>
              <option>Desa Getas (Tubing Genting)</option>
              <option>Desa Berjo</option>
              <option>Desa Dieng Kulon</option>
            </select>
            <ChevronDown class="w-4 h-4 text-slate-400 absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none" />
          </div>
        </div>

        <!-- Tahun Anggaran -->
        <div class="lg:col-span-2">
          <label class="block text-xs font-bold text-[#0D2453] mb-1.5">
            Tahun Anggaran
          </label>
          <div class="relative">
            <select
              class="w-full bg-[#F5F5F5] border-0 rounded-xl px-4 py-3 text-xs sm:text-sm text-[#0D2453] font-medium focus:ring-2 focus:ring-[#0D2453]/20 focus:outline-none appearance-none cursor-pointer"
            >
              <option selected>2026</option>
              <option>2025</option>
              <option>2024</option>
              <option>2023</option>
            </select>
            <ChevronDown class="w-4 h-4 text-slate-400 absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none" />
          </div>
        </div>

        <!-- Tombol Tampilkan -->
        <div class="lg:col-span-2">
          <button
            type="button"
            class="w-full py-3.5 px-6 rounded-xl bg-[#0D2453] hover:bg-[#132d66] text-white font-bold text-xs sm:text-sm transition-all shadow-xs active:scale-[0.98]"
          >
            Tampilkan
          </button>
        </div>
      </div>
    </section>

    <!-- 3. Village Header Banner Card -->
    <section class="bg-[#0D2453] rounded-3xl p-6 sm:p-8 text-white shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
          Desa Candirejo
        </h2>
        <p class="text-xs sm:text-sm text-slate-300 mt-1 font-medium">
          Borobudur, Kabupaten Magelang • Tahun anggaran 2026
        </p>
      </div>

      <div class="text-left sm:text-right">
        <span class="text-xs text-slate-300 font-medium block">
          Total Pendanaan
        </span>
        <span class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight block mt-0.5">
          Rp 1.200.000.000
        </span>
      </div>
    </section>

    <!-- 4. Two Comparison Cards: Sumber Pendanaan vs Dana Terpakai -->
    <section class="grid grid-cols-1 lg:grid-cols-2 gap-6">

      <!-- Card A: Sumber Pendanaan Desa (Donut Chart) -->
      <div class="bg-white rounded-3xl border border-[#EBEBEB] p-6 sm:p-8 shadow-xs flex flex-col justify-between">
        <div>
          <h3 class="text-base sm:text-lg font-bold text-[#0D2453]">
            Sumber Pendanaan Desa
          </h3>
          <p class="text-xs text-[#767676] mt-0.5 mb-6">
            Beberapa sumber pendapatan desa wisata.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-12 gap-6 items-center">
          <!-- Donut Chart Canvas SVG -->
          <div class="sm:col-span-6 flex items-center justify-center relative">
            <svg class="w-44 h-44 -rotate-90 transform" viewBox="0 0 160 160">
              <!-- Background Circle Track -->
              <circle
                cx="80"
                cy="80"
                r="62"
                stroke="#E2E8F0"
                stroke-width="24"
                fill="transparent"
              />
              <!-- Segment 1: APBDes (60%) -> circumference = 2 * PI * 62 = 389.56; 60% = 233.74 -->
              <circle
                cx="80"
                cy="80"
                r="62"
                stroke="#0D2453"
                stroke-width="24"
                stroke-dasharray="233.74 389.56"
                stroke-dashoffset="0"
                fill="transparent"
              />
              <!-- Segment 2: Bantuan Provinsi (25%) -> 25% = 97.39; offset = -233.74 -->
              <circle
                cx="80"
                cy="80"
                r="62"
                stroke="#3B82F6"
                stroke-width="24"
                stroke-dasharray="97.39 389.56"
                stroke-dashoffset="-233.74"
                fill="transparent"
              />
              <!-- Segment 3: PADes Wisata (15%) -> 15% = 58.43; offset = -331.13 -->
              <circle
                cx="80"
                cy="80"
                r="62"
                stroke="#93C5FD"
                stroke-width="24"
                stroke-dasharray="58.43 389.56"
                stroke-dashoffset="-331.13"
                fill="transparent"
              />
            </svg>

            <!-- Center Text in Donut -->
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center pointer-events-none">
              <span class="text-base sm:text-lg font-bold text-[#0D2453] leading-tight">
                Rp 1,2 Miliar
              </span>
              <span class="text-[10px] text-[#767676] font-medium">
                Total pendanaan
              </span>
            </div>
          </div>

          <!-- Legend Items -->
          <div class="sm:col-span-6 space-y-4">
            <!-- Legend 1: APBDes -->
            <div class="flex items-start justify-between">
              <div class="flex items-start gap-2.5">
                <span class="w-3 h-3 rounded-xs bg-[#0D2453] mt-0.5 shrink-0"></span>
                <div>
                  <span class="text-xs font-bold text-[#0D2453] block leading-tight">APBDes</span>
                  <span class="text-[11px] text-[#767676] block mt-0.5">Rp 720.000.000</span>
                </div>
              </div>
              <span class="text-xs font-bold text-[#0D2453]">60%</span>
            </div>

            <!-- Legend 2: Bantuan Provinsi -->
            <div class="flex items-start justify-between">
              <div class="flex items-start gap-2.5">
                <span class="w-3 h-3 rounded-xs bg-[#3B82F6] mt-0.5 shrink-0"></span>
                <div>
                  <span class="text-xs font-bold text-[#0D2453] block leading-tight">Bantuan Provinsi</span>
                  <span class="text-[11px] text-[#767676] block mt-0.5">Rp 300.000.000</span>
                </div>
              </div>
              <span class="text-xs font-bold text-[#0D2453]">25%</span>
            </div>

            <!-- Legend 3: PADes Wisata -->
            <div class="flex items-start justify-between">
              <div class="flex items-start gap-2.5">
                <span class="w-3 h-3 rounded-xs bg-[#93C5FD] mt-0.5 shrink-0"></span>
                <div>
                  <span class="text-xs font-bold text-[#0D2453] block leading-tight">PADes Wisata</span>
                  <span class="text-[11px] text-[#767676] block mt-0.5">Rp 180.000.000</span>
                </div>
              </div>
              <span class="text-xs font-bold text-[#0D2453]">15%</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Card B: Dana Terpakai (Progress Bar & Stats) -->
      <div class="bg-white rounded-3xl border border-[#EBEBEB] p-6 sm:p-8 shadow-xs flex flex-col justify-between">
        <div>
          <h3 class="text-base sm:text-lg font-bold text-[#0D2453]">
            Dana Terpakai
          </h3>
          <p class="text-xs text-[#767676] mt-0.5 mb-6">
            Realisasi belanja dan saldo kas yang tersisa.
          </p>
        </div>

        <div class="space-y-6">
          <!-- 70% Big Indicator -->
          <div class="flex items-baseline justify-between">
            <div class="text-5xl font-extrabold text-[#0D2453] tracking-tight">
              70%
            </div>
            <div class="text-xs text-[#767676] font-medium">
              dari total dana telah terpakai
            </div>
          </div>

          <!-- Progress Bar Track -->
          <div class="w-full h-4 rounded-full bg-[#DCE7F5] overflow-hidden flex">
            <div class="h-full bg-[#0D2453] rounded-full" style="width: 70%"></div>
          </div>

          <!-- Bottom Summary (Dana Terpakai vs Sisa Saldo Kas) -->
          <div class="grid grid-cols-2 gap-4 pt-2">
            <div>
              <div class="flex items-center gap-1.5 text-xs text-[#767676] mb-1 font-medium">
                <span class="w-2.5 h-2.5 rounded-xs bg-[#0D2453]"></span>
                <span>Dana Terpakai • 70%</span>
              </div>
              <div class="text-base sm:text-lg font-bold text-[#0D2453]">
                Rp 840.000.000
              </div>
            </div>

            <div>
              <div class="flex items-center gap-1.5 text-xs text-[#767676] mb-1 font-medium">
                <span class="w-2.5 h-2.5 rounded-xs bg-[#DCE7F5]"></span>
                <span>Sisa Saldo Kas • 30%</span>
              </div>
              <div class="text-base sm:text-lg font-bold text-[#0D2453]">
                Rp 360.000.000
              </div>
            </div>
          </div>
        </div>
      </div>

    </section>

    <!-- 5. Table Section: Laporan Pengeluaran Desa Wisata -->
    <section class="bg-white rounded-3xl border border-[#EBEBEB] p-6 sm:p-8 shadow-xs space-y-6">
      <!-- Section Header -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div>
          <h3 class="text-lg sm:text-xl font-bold text-[#0D2453]">
            Laporan Pengeluaran Desa Wisata
          </h3>
          <p class="text-xs text-[#767676] mt-0.5">
            Setiap pengeluaran disertai nota dan dokumentasi fisik. Klik bukti untuk memperbesar.
          </p>
        </div>
        <div class="text-xs text-[#767676] font-medium">
          Oktober 2026
        </div>
      </div>

      <!-- Expenditures Table -->
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm text-[#0D2453]">
          <!-- Table Head with Soft Blue Tint as in Figma -->
          <thead>
            <tr class="bg-[#DCE7F5]/70 text-[#0D2453] text-xs font-semibold">
              <th scope="col" class="px-5 py-3.5 rounded-l-xl">Tanggal</th>
              <th scope="col" class="px-5 py-3.5">Nama Kegiatan / Fasilitas</th>
              <th scope="col" class="px-5 py-3.5">Nominal (Rp)</th>
              <th scope="col" class="px-5 py-3.5 rounded-r-xl">Foto Bukti Nota & Fisik</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-[#EBEBEB]">
            {expenditures.map((row) => (
              <tr class="hover:bg-slate-50/70 transition-colors">
                <!-- Tanggal -->
                <td class="px-5 py-4 whitespace-nowrap text-xs text-[#0D2453] font-medium align-middle">
                  {row.date}
                </td>

                <!-- Kegiatan -->
                <td class="px-5 py-4 align-middle">
                  <div class="font-bold text-[#0D2453] text-xs sm:text-sm">{row.title}</div>
                  <div class="text-[11px] text-[#767676] mt-0.5">{row.sub}</div>
                </td>

                <!-- Nominal -->
                <td class="px-5 py-4 whitespace-nowrap font-medium text-[#0D2453] text-xs sm:text-sm align-middle">
                  {row.amount}
                </td>

                <!-- Foto Bukti Nota & Fisik -->
                <td class="px-5 py-4 align-middle">
                  <div class="flex items-center gap-3">
                    <!-- Nota Box -->
                    <div class="flex flex-col">
                      <div class="w-16 h-11 rounded-lg bg-[#E2E8F0] border border-slate-300 flex items-center justify-center text-[9px] font-bold text-[#475569] tracking-tighter text-center px-1 leading-tight select-none">
                        NOTA KUITANSI
                      </div>
                      <a
                        href={row.receiptImg}
                        target="_blank"
                        rel="noreferrer"
                        class="inline-flex items-center gap-0.5 text-[10px] text-[#0D2453] font-medium mt-1 hover:underline"
                      >
                        <span>Nota</span>
                        <ArrowUpRight class="w-2.5 h-2.5" />
                      </a>
                    </div>

                    <!-- Foto Fisik Box -->
                    <div class="flex flex-col">
                      <div class="w-16 h-11 rounded-lg overflow-hidden border border-slate-200 bg-slate-100">
                        <img
                          src={row.photoImg}
                          alt={row.title}
                          class="w-full h-full object-cover"
                        />
                      </div>
                      <a
                        href={row.photoImg}
                        target="_blank"
                        rel="noreferrer"
                        class="inline-flex items-center gap-0.5 text-[10px] text-[#0D2453] font-medium mt-1 hover:underline"
                      >
                        <span>Foto fisik</span>
                        <ArrowUpRight class="w-2.5 h-2.5" />
                      </a>
                    </div>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>

          <!-- Table Footer Total Summary -->
          <tfoot>
            <tr class="bg-slate-50/70 border-t border-[#EBEBEB] text-xs font-semibold text-[#0D2453]">
              <td class="px-5 py-4" colspan="2">
                <span class="font-bold text-[#0D2453] text-sm">Total belanja tercatat</span>
              </td>
              <td class="px-5 py-4">
                <span class="font-bold text-[#0D2453] text-sm">840.000.000</span>
              </td>
              <td class="px-5 py-4 text-xs text-[#767676] font-normal">
                Sama dengan dana terpakai • 70%
              </td>
            </tr>
          </tfoot>
        </table>
      </div>

      <!-- Pagination Bar exactly matching Figma -->
      <div class="flex items-center justify-center gap-2 pt-4 pb-2 text-xs font-semibold text-[#767676]">
        <button class="inline-flex items-center gap-1 hover:text-[#0D2453] transition-colors pr-2">
          <span>&larr; Prev 10</span>
        </button>

        <span class="px-1.5 py-1 hover:text-[#0D2453] cursor-pointer">1</span>
        <span class="px-1 text-slate-400">...</span>
        <span class="px-1.5 py-1 hover:text-[#0D2453] cursor-pointer">11</span>

        <!-- Active Page 12 with Blue Underline Pill -->
        <div class="flex flex-col items-center">
          <span class="px-2 py-0.5 text-[#0D2453] font-bold">12</span>
          <span class="w-4 h-0.5 bg-[#0D2453] rounded-full"></span>
        </div>

        <span class="px-1.5 py-1 hover:text-[#0D2453] cursor-pointer">13</span>
        <span class="px-1.5 py-1 hover:text-[#0D2453] cursor-pointer">14</span>
        <span class="px-1.5 py-1 hover:text-[#0D2453] cursor-pointer">15</span>
        <span class="px-1.5 py-1 hover:text-[#0D2453] cursor-pointer">16</span>
        <span class="px-1.5 py-1 hover:text-[#0D2453] cursor-pointer">17</span>
        <span class="px-1.5 py-1 hover:text-[#0D2453] cursor-pointer">18</span>
        <span class="px-1.5 py-1 hover:text-[#0D2453] cursor-pointer">19</span>
        <span class="px-1.5 py-1 hover:text-[#0D2453] cursor-pointer">20</span>
        <span class="px-1 text-slate-400">...</span>
        <span class="px-1.5 py-1 hover:text-[#0D2453] cursor-pointer">78</span>

        <button class="inline-flex items-center gap-1 hover:text-[#0D2453] transition-colors pl-2">
          <span>Next 10 &rarr;</span>
        </button>
      </div>
    </section>

  </div>
</Layout>
